{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/support/*": ["./support/*"],
      "@/pages/*": ["./support/pages/*"],
      "@/fixtures/*": ["./support/fixtures/*"],
      "@/constants/*": ["./support/constants*"]
    }
  },
  "include": ["**/*.ts"]
}
