# Copy this file to `.env.e2e` (gitignored) and fill in real values.

# Base URL of the Blocks Localization app under test.
#
# Local Vite frontend (recommended for dev + codegen):
#   ./run.sh -f   # from repo root — starts Vite on :4000
#   E2E_BASE_URL=https://dev-localization.blocksdevelopers.com:4000
#   E2E_NO_WEBSERVER=1
#
# Remote dev (no local server):
#   E2E_BASE_URL=https://dev-localization.blocksdevelopers.com
#   E2E_NO_WEBSERVER=1
#
# Local API + built client: run `./run.sh` and use
#   E2E_BASE_URL=https://dev-localization.blocksdevelopers.com:5000
# with E2E_NO_WEBSERVER unset, so Playwright starts `run.sh -b` itself.
E2E_BASE_URL=https://dev-localization.blocksdevelopers.com:4000

# Base URL of the OS app. The setup project creates the run's test project
# here, and the global teardown deletes it from here. Required.
E2E_OS_BASE_URL=https://dev-os.blocksdevelopers.com

# Dev-IAM test account credentials (captcha is disabled on dev).
E2E_USERNAME=
E2E_PASSWORD=

# Set to 1 to skip auto-starting the app (you manage the server yourself, or
# you are testing a remote host). Required when E2E_BASE_URL is not local.
E2E_NO_WEBSERVER=1

# Pause after each test so the end state is watchable. Defaults to 10000 in
# headed mode and 0 when headless; set a value to override either way.
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action, to watch the steps themselves.
# E2E_SLOWMO=600

# Repo the OS setup attaches the new test project to. Override if your test
# fixtures live in a different GitHub repo.
# E2E_OS_TEST_REPO_OWNER=SELISEdigitalplatforms
# E2E_OS_TEST_REPO_NAME=blocks-localization-fixtures

# Project name prefix used by the setup project. The full name is
# `<prefix> <Date.now()>`, so reruns never collide. Override only if you need
# a recognisable name in the OS console for debugging.
# (The setup hard-codes `Localization Test` as the prefix.)
