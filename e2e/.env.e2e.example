# Copy this file to `.env.e2e` (gitignored) and fill in real values.

# Base URL of the Blocks Localization app under test.
#
# Remote dev (default, no local server needed):
#   E2E_BASE_URL=https://dev-localization.blocksdevelopers.com
#   E2E_NO_WEBSERVER=1
#
# Local build: run `./run.sh` (client build + .NET server on :5000) and use
#   E2E_BASE_URL=http://localhost:5000
# with E2E_NO_WEBSERVER unset, so Playwright starts `run.sh -b` itself.
E2E_BASE_URL=https://dev-localization.blocksdevelopers.com

# Dev-IAM test account credentials (captcha is disabled on dev).
E2E_USERNAME=
E2E_PASSWORD=

# Set to 1 to skip auto-starting the app (you manage the server yourself, or
# you are testing a remote host). Required when E2E_BASE_URL is not local.
E2E_NO_WEBSERVER=1

# Pause after each test so the end state is watchable. Defaults to 10000 in
# headed mode and 0 when headless; set a value to override either way.
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action, to watch the steps themselves.
# E2E_SLOWMO=600
