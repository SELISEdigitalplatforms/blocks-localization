# Copy this file to `.env.e2e` (gitignored) and fill in real values.
#
# Switch environments by changing E2E_BASE_URL only — OS is derived automatically:
#   Dev:  https://dev-localization.blocksdevelopers.com  → OS https://dev-os.blocksdevelopers.com
#   Prod: https://localization.seliseblocks.com          → OS https://os.seliseblocks.com
# Override OS anytime with E2E_OS_BASE_URL.

# ── Dev (blocksdevelopers.com) ──────────────────────────────────────────────
E2E_BASE_URL=https://dev-localization.blocksdevelopers.com
# E2E_OS_BASE_URL=https://dev-os.blocksdevelopers.com

# ── Prod (seliseblocks.com) — uncomment these and comment Dev above ──────────
# E2E_BASE_URL=https://localization.seliseblocks.com
# E2E_OS_BASE_URL=https://os.seliseblocks.com

# Local Vite frontend (recommended for codegen):
#   ./run.sh -f   # from repo root — starts Vite on :4000
#   E2E_BASE_URL=https://dev-localization.blocksdevelopers.com:4000
#   E2E_OS_BASE_URL=https://dev-os.blocksdevelopers.com   # required: Vite port ≠ OS
#   E2E_NO_WEBSERVER=1
#
# Local API + built client via named domain + hosts entry (API_PORT 5000):
#   127.0.0.1 dev-localization.blocksdevelopers.com
#   E2E_BASE_URL=https://dev-localization.blocksdevelopers.com:5000
#   # OS derives to :5000; override with E2E_OS_BASE_URL if OS is elsewhere

# Test account credentials: project admin with every localization permission
# (including glossary::migrate and key::gets).
E2E_USERNAME=
E2E_PASSWORD=

# Permission tests (SPEC15). Both accounts must be members of the shared project, so reuse a
# fixed project (E2E_REUSE_PROJECT_NAME or E2E_PROJECT_ID). Tests that need them skip when unset.
# Restricted: glossary::gets, glossary::save, glossary::delete; NOT key::gets.
E2E_RESTRICTED_USERNAME=
E2E_RESTRICTED_PASSWORD=
# Read-only: glossary::gets, glossary::delete, key::gets; NOT glossary::save.
E2E_READONLY_USERNAME=
E2E_READONLY_PASSWORD=

# Optional project name prefix — each run creates `${PROJECT_NAME} ${Date.now()}` unless reusing below.
# PROJECT_NAME=LOCALIZATION-TEST

# Reuse a fixed project instead of creating one each run.
# When unset: always create a new project (or reuse orphan only if console is full).
# E2E_REUSE_PROJECT_NAME=Testing

# Open a project by UUID (/app/{id}/dashboard) — skips console card search.
# E2E_PROJECT_ID=

# Keep the shared project after the run (also kept automatically on failure).
# E2E_KEEP_PROJECT=1

# Set to 1 to skip auto-starting the app (you manage the server, or remote host).
E2E_NO_WEBSERVER=1

# Pause after each test (default 10000 headed / 0 headless).
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action.
# E2E_SLOWMO=600

# Opt-in evidence specs (screenshots, keyboard walks, axe, timings).
# E2E_VISUAL=1

# SPEC15 German check: 1 uses the dev remote dictionary as seeded; unset stubs a pseudo-German
# dictionary built from client/app/i18n/localization.glossary.en.json.
# E2E_DE_REMOTE=1
