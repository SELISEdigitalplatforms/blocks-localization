<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>BlocksTemplate.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Emit XML doc output into the build output (bin/) instead of the source
         tree, so it is not committed and never shows up as a stale dirty file. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="appsettings.Development.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="appsettings.Development.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="SeliseBlocks.ConfigurationDriver" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Eurolm.DomainService\Eurolm.DomainService.csproj" />
  </ItemGroup>
</Project>