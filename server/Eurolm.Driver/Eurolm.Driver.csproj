<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>4.0.1</Version>
		<PackageId>SeliseBlocks.Localization.OS</PackageId>
		<Authors>SeliseBlocks</Authors>
		<Company>SeliseBlocks</Company>
		<Description>Blocks Eurolm Driver</Description>
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<IncludeOutputAssemblies>true</IncludeOutputAssemblies>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>Genesis, BlocksGenesis, SeliseBlocksGenesis, Localization, Language, Driver</PackageTags>
		<RepositoryUrl>https://github.com/SELISEdigitalplatforms/blocks-localization</RepositoryUrl>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Eurolm.DomainService/Eurolm.DomainService.csproj" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" />
		<PackageReference Include="CsvHelper" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="SeliseBlocks.Genesis" />
        <PackageReference Include="SeliseBlocks.StorageDriver.OS" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)Eurolm.DomainService.dll" Pack="true" PackagePath="lib/net10.0/" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
