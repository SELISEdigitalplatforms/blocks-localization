# Vite exposes only names prefixed with `BLOCKS_` (see client/vite.config.ts).
# envDir is the repo root — copy this file to `../.env` or merge these keys there, then restart Vite / rebuild.
#
# Required for real auth flows:
#   BLOCKS_API_BASE_URL — IDP / API base URL the SPA calls.
#   BLOCKS_X_BLOCKS_KEY — sent as x-blocks-key; also used to load sign-up settings (leave empty only for limited local tests).
# If login options API returns an odd shape, rebuild the client after updating the app (see sign-in page guards).

BLOCKS_APP_URL=https://dev-cloud.seliseblocks.com
BLOCKS_API_BASE_URL=https://dev-api.seliseblocks.com
BLOCKS_X_BLOCKS_KEY=
BLOCKS_CONSTRUCT_URL=https://dev-construct.seliseblocks.com
BLOCKS_PROJECT_DEFAULT_API_BASE_URL=dev-api.seliseblocks.com
BLOCKS_GOOGLE_SITE_KEY=
BLOCKS_BLOCKS_DEFAULT_STORAGE_HOST=blocksdev.blob.core.windows.net
BLOCKS_BLOCKED_MENU=[]
BLOCKS_AI_WIDGET_CDN_LINK=
BLOCKS_GITHUB_SSO_CLIENT_ID=
BLOCKS_CLARITY_PROJECT_ID=
BLOCKS_APP_ENV=dev
BLOCKS_WIDGET_ID=
BLOCKS_WIDGET_URL=
BLOCKS_SCA_PORTAL_LINK=
BLOCKS_BLOCKED_KEY=[]
BLOCKS_BLOCKED_USER_IDS=[]
BLOCKS_UILM_PROJECT_KEY=
BLOCKS_PUBLIC_BASE_DOMAIN=seliseblocks.com
